<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0.1</Version>
    <PackageProjectUrl>https://github.com/DriftlessDigits/BalambGarden</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECommons\ECommons\ECommons.csproj" />
    <ProjectReference Include="..\BalambGarden.Engine\BalambGarden.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev loads read images/icon.png beside the DLL (IconUrl is only fetched for
         repo installs), and DalamudPackager folds the folder into the release zip. -->
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
